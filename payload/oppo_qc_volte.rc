# HD OPPO/Realme Qualcomm — ColorOS 6/7 (A11 trinket) + ColorOS 11 (oplus)
# persist.* phai set lai sau khi persist mount (post-fs-data), khong chi early-init
on early-init
    setprop persist.sys.oppo.radio.show_volte 1
    setprop persist.sys.oppo.radio.volte_icon 1
    setprop persist.sys.oppo.radio.volte_switch 1
    setprop persist.sys.oplus.radio.show_volte 1
    setprop persist.sys.oplus.radio.volte_icon 1
    setprop persist.sys.oplus.radio.volte_switch 1

on post-fs-data
    setprop persist.sys.oppo.radio.show_volte 1
    setprop persist.sys.oppo.radio.volte_icon 1
    setprop persist.sys.oppo.radio.volte_switch 1
    setprop persist.sys.oppo.show_volte 1
    setprop persist.radio.oppo.show_volte 1
    setprop persist.sys.oppo.ims.enable 1
    setprop persist.sys.oem_vt_enabled 1
    setprop persist.sys.oppo.multicc_volte 1
    setprop persist.sys.oppo.multisim_volte 1
    setprop persist.radio.hvolte.enable 1
    setprop persist.show.cu.volte 1
    setprop persist.sys.oppo.region VN
    setprop persist.sys.oplus.radio.show_volte 1
    setprop persist.sys.oplus.radio.volte_icon 1
    setprop persist.sys.oplus.radio.volte_switch 1
    setprop persist.oplus.radio.volte_icon 1
    setprop persist.dbg.ims_volte_enable 1
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.dbg.allow_ims_off 0
    setprop persist.radio.calls.on.ims 1
    setprop persist.radio.volte_state 1
    setprop persist.vendor.radio.volte_avail_ovr 1
    setprop persist.vendor.radio.vt_avail_ovr 1
    setprop persist.vendor.radio.calls.on.ims 1
    setprop persist.vendor.ims.enable 1
    setprop persist.vendor.radio.ims_enable 1

on boot
    setprop persist.dbg.ims_volte_enable 1
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.dbg.allow_ims_off 0
    setprop persist.radio.calls.on.ims 1
    setprop persist.radio.volte_state 1
    setprop persist.radio.VT_ENABLE 1
    setprop persist.radio.videopause.mode 1
    setprop persist.radio.rat_on combine
    setprop persist.radio.data_ltd_sys_ind 1
    setprop persist.radio.data_con_rprt 1
    setprop persist.radio.volte.dan_support true
    setprop persist.data.iwlan.enable true
    setprop persist.data.iwlan 1
    setprop persist.data.iwlan.ipsec.ap 1
    setprop persist.rcs.supported 1
    setprop persist.sys.cust.lte_config true
    setprop persist.vendor.radio.volte_avail_ovr 1
    setprop persist.vendor.radio.vt_avail_ovr 1
    setprop persist.vendor.radio.calls.on.ims 1
    setprop persist.vendor.ims.enable 1
    setprop persist.vendor.radio.ims_enable 1
    setprop persist.sys.oplus.radio.volte_icon 1
    setprop persist.sys.oplus.radio.show_volte 1
    setprop persist.sys.oplus.radio.volte_switch 1
    setprop persist.oplus.radio.volte_icon 1
    setprop persist.radio.volte.icon 1
    setprop persist.sys.oppo.radio.show_volte 1
    setprop persist.sys.oppo.radio.volte_icon 1
    setprop persist.sys.oppo.radio.volte_switch 1
    setprop persist.sys.oppo.show_volte 1
    setprop persist.radio.oppo.show_volte 1
    setprop persist.sys.oppo.ims.enable 1
    setprop persist.sys.oem_vt_enabled 1
    setprop persist.sys.oppo.multicc_volte 1
    setprop persist.sys.oppo.multisim_volte 1
    setprop persist.radio.hvolte.enable 1
    setprop persist.show.cu.volte 1
    setprop persist.sys.oppo.region VN
    setprop ro.oppo.radio.show_volte 1
    setprop ro.oppo.radio.support_volte 1
    setprop ro.oplus.radio.support_volte 1
    setprop ro.oplus.radio.show_volte_switch 1

on property:sys.boot_completed=1
    setprop persist.dbg.ims_volte_enable 1
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.dbg.allow_ims_off 0
    setprop persist.radio.calls.on.ims 1
    setprop persist.radio.volte_state 1
    setprop persist.radio.VT_ENABLE 1
    setprop persist.radio.videopause.mode 1
    setprop persist.radio.rat_on combine
    setprop persist.radio.data_ltd_sys_ind 1
    setprop persist.radio.data_con_rprt 1
    setprop persist.radio.volte.dan_support true
    setprop persist.data.iwlan.enable true
    setprop persist.data.iwlan 1
    setprop persist.data.iwlan.ipsec.ap 1
    setprop persist.rcs.supported 1
    setprop persist.sys.cust.lte_config true
    setprop persist.vendor.radio.volte_avail_ovr 1
    setprop persist.vendor.radio.vt_avail_ovr 1
    setprop persist.vendor.radio.calls.on.ims 1
    setprop persist.vendor.ims.enable 1
    setprop persist.vendor.radio.ims_enable 1
    setprop persist.sys.oplus.radio.volte_icon 1
    setprop persist.sys.oplus.radio.show_volte 1
    setprop persist.sys.oplus.radio.volte_switch 1
    setprop persist.oplus.radio.volte_icon 1
    setprop persist.radio.volte.icon 1
    setprop persist.sys.oppo.radio.show_volte 1
    setprop persist.sys.oppo.radio.volte_icon 1
    setprop persist.sys.oppo.radio.volte_switch 1
    setprop persist.sys.oppo.show_volte 1
    setprop persist.radio.oppo.show_volte 1
    setprop persist.sys.oppo.ims.enable 1
    setprop persist.sys.oem_vt_enabled 1
    setprop persist.sys.oppo.multicc_volte 1
    setprop persist.sys.oppo.multisim_volte 1
    setprop persist.radio.hvolte.enable 1
    setprop persist.show.cu.volte 1
    setprop persist.sys.oppo.region VN
